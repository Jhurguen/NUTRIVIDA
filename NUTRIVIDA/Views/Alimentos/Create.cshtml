@model NutriVida.Models.Alimento

@{
    ViewData["Title"] = "Nuevo Alimento";
}

<h1>Registrar Alimento</h1>

<form asp-action="Create">
    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="NombreAlimento" class="form-control" />
    </div>
    <div class="form-group">
        <label>Tipo</label>
        <input asp-for="Tipo" class="form-control" />
    </div>
    <div class="form-group">
        <label>Calorías</label>
        <input asp-for="Calorias" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
</form>
