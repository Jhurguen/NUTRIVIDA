@model NutriVida.Models.Alimento

@{
    ViewData["Title"] = "Eliminar Alimento";
}

<h1>Eliminar</h1>

<h3>¿Seguro que deseas eliminar este alimento?</h3>
<div>
    <h4>@Model.NombreAlimento</h4>
    <p>Tipo: @Model.Tipo</p>
    <p>Calorías: @Model.Calorias</p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button> |
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
