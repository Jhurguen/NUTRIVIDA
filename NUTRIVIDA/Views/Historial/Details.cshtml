@model NutriVida.Models.Historial

@{
    ViewData["Title"] = "Detalles de la Consulta";
}

<h1>Detalles</h1>

<div>
    <h4>Consulta</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Paciente</dt>
        <dd class="col-sm-10">@Model.Paciente?.Nombre</dd>
        <dt class="col-sm-2">Fecha</dt>
        <dd class="col-sm-10">@Model.FechaConsulta.ToShortDateString()</dd>
        <dt class="col-sm-2">Observaciones</dt>
        <dd class="col-sm-10">@Model.Observaciones</dd>
    </dl>
</div>
<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</p>
