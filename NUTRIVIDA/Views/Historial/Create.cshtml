@model NutriVida.Models.Historial

@{
    ViewData["Title"] = "Nueva Consulta";
}

<h1>Registrar Consulta</h1>

<form asp-action="Create">
    <div class="form-group">
        <label>Paciente</label>
        <input asp-for="PacienteId" class="form-control" />
    </div>
    <div class="form-group">
        <label>Fecha</label>
        <input asp-for="FechaConsulta" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>Observaciones</label>
        <textarea asp-for="Observaciones" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
</form>
