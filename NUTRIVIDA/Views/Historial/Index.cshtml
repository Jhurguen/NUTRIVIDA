@model IEnumerable<NutriVida.Models.Historial>

@{
    ViewData["Title"] = "Historial de Consultas";
}

<h1>Historial</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Consulta</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Paciente</th>
            <th>Fecha</th>
            <th>Observaciones</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Paciente?.Nombre</td>
                <td>@item.FechaConsulta.ToShortDateString()</td>
                <td>@item.Observaciones</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
