@model IEnumerable<NutriVida.Models.Plan>

@{
    ViewData["Title"] = "Planes Nutricionales";
}

<h1>Planes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Plan</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre del Plan</th>
            <th>Descripción</th>
            <th>Fecha de Creación</th>
            <th>Paciente</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NombrePlan</td>
                <td>@item.Descripcion</td>
                <td>@item.FechaCreacion.ToShortDateString()</td>
                <td>@item.Paciente?.Nombre</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
