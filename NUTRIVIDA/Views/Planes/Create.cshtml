@model NutriVida.Models.Plan

@{
    ViewData["Title"] = "Nuevo Plan";
}

<h1>Registrar Plan</h1>

<form asp-action="Create">
    <div class="form-group">
        <label>Nombre del Plan</label>
        <input asp-for="NombrePlan" class="form-control" />
    </div>
    <div class="form-group">
        <label>Descripción</label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>
    <div class="form-group">
        <label>Fecha de Creación</label>
        <input asp-for="FechaCreacion" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label>Paciente</label>
        <input asp-for="PacienteId" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
</form>
